<%# locals: (item:) %>
<li class="relative flex gap-4 pb-[22px] pl-[22px] lg:gap-6 lg:pb-7 lg:pl-7">
  <span
    aria-hidden="true"
    class="
      <%= class_names(
      "absolute top-1.5 -left-1.5 box-border size-[11px] rounded-full border-2 lg:top-2 lg:-left-[7px] lg:size-[13px]",
      "border-clay bg-clay" => item[:highlight],
      "border-sage bg-ground" => !item[:highlight]
      ) %>
    "
  ></span>

  <span class="flex-none basis-16 font-display text-[22px] font-semibold text-clay lg:basis-21 lg:text-[28px]">
    <%= item[:time] %>
  </span>

  <div class="flex flex-col gap-0.5 lg:gap-1">
    <span class="text-[17px] font-semibold lg:text-[19px]"><%= item[:name] %></span>
    <span class="text-sm text-ink-muted lg:text-[15px]"><%= item[:body] %></span>
  </div>
</li>
