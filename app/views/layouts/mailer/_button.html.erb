<%# locals: (text:, url:) %>
<table
  role="presentation"
  class="mail-button-table"
  cellpadding="0"
  cellspacing="0"
  border="0"
  style="margin: 6px 0 14px;"
>
  <tr>
    <td align="center" style="background: #56684f; border-radius: 999px;">
      <%= link_to text, url,
            class: "mail-button",
            style: "display: inline-block; padding: 16px 32px; border-radius: 999px; font-size: 15px; font-weight: 600; line-height: 18px; color: #f5f0e6; text-decoration: none;" %>
    </td>
  </tr>
</table>
