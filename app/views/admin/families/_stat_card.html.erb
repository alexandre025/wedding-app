<%# locals: (caption:, value:, emphasis: false) %>
<div class="flex flex-1 basis-[200px] flex-col gap-1 rounded-[14px] border border-rule-sage bg-white px-5 py-[18px]">
  <span class="text-[13px] text-ink-muted"><%= caption %></span>

  <span class="<%= class_names('font-display text-4xl leading-none font-semibold', 'text-clay' => emphasis) %>">
    <%= value %>
  </span>
</div>
