<% content_for :title, t("admin.families.index.title") %>

<main class="mx-auto flex w-full max-w-[1200px] grow flex-col gap-7 px-6 pt-10 pb-20">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
    <div class="flex flex-col gap-1.5">
      <h1 class="font-display text-[48px] leading-none font-medium"><%= t("admin.families.index.title") %></h1>
      <p class="text-[15px] text-ink-muted"><%= t("admin.families.index.intro") %></p>
    </div>

    <%= link_to new_admin_family_path,
          class: "inline-flex h-12 items-center gap-2 rounded-full bg-sage-deep px-[22px] font-semibold text-ground" do %>
      <%= icon("plus") %>
      <%= t("admin.families.index.add") %>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-4">
    <%= render "admin/families/stat_card", caption: t("admin.families.index.stats.families"), value: @families_count %>
    <%= render "admin/families/stat_card", caption: t("admin.families.index.stats.guests"), value: @guests_count %>

    <%= render "admin/families/stat_card", caption: t("admin.families.index.stats.answered"),
          value: t("admin.families.index.stats.ratio", answered: @answered_count, total: @families_count) %>

    <%= render "admin/families/stat_card", caption: t("admin.families.index.stats.pending"),
          value: @families_count - @answered_count, emphasis: true %>
  </div>

  <%= search_form_for @search, url: admin_families_path,
        html: {
          class: "flex max-w-[420px] flex-col gap-1.5",
          data: {
            controller: "search-field",
            search_field_delay_value: 300,
            turbo_frame: "families_results"
          }
        } do |f| %>
    <%= f.label Family::SEARCH_PREDICATE, t("admin.families.index.search_label"), class: "text-sm font-semibold" %>

    <div class="relative">
      <%= f.search_field Family::SEARCH_PREDICATE, placeholder: t("admin.families.index.search_placeholder"),
            autocomplete: "off",
            data: { search_field_target: "field", action: "input->search-field#search" },
            class: "
              h-[46px] w-full rounded-[10px] border border-rule-sand bg-white pr-12 pl-[14px] text-base text-ink
              [&::-webkit-search-cancel-button]:appearance-none
            " %>

      <button
        type="button"
        hidden
        aria-label="<%= t("admin.families.index.search_clear") %>"
        data-search-field-target="clear"
        data-action="search-field#clear"
        class="absolute top-1/2 right-[1px] flex size-11 -translate-y-1/2 items-center justify-center text-ink-muted"
      >
        <%= icon("close") %>
      </button>
    </div>
  <% end %>

  <%= turbo_frame_tag "families_results", target: "_top",
        class: "block overflow-x-auto rounded-2xl border border-rule-sage bg-white" do %>
    <div class="min-w-[800px]">
      <div
        aria-hidden="true"
        class="
          grid grid-cols-[minmax(150px,1fr)_minmax(320px,2.6fr)_130px_200px] gap-4 border-b border-rule-sage px-5
          py-3.5 text-xs font-semibold tracking-column text-ink-muted uppercase
        "
      >
        <span><%= t("admin.families.index.columns.family") %></span>
        <span><%= t("admin.families.index.columns.members") %></span>
        <span><%= t("admin.families.index.columns.answer") %></span>
        <span></span>
      </div>

      <% if @families.any? %>
        <ul class="flex flex-col [&>li:last-child]:border-b-0">
          <%= render partial: "admin/families/family_row", collection: @families, as: :family %>
        </ul>
      <% else %>
        <p class="px-5 py-8 text-center text-[15px] text-ink-muted">
          <%= @query.present? ? t("admin.families.index.none_matching", query: @query) : t("admin.families.index.none") %>
        </p>
      <% end %>
    </div>
  <% end %>
</main>
