<%# locals: (member:) %>
<li class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3 border-b border-rule-row px-5 py-4">
  <div class="flex min-w-0 grow flex-col gap-1">
    <span class="flex flex-wrap items-center gap-x-2">
      <span class="font-semibold"><%= member.first_name %></span>

      <span class="member-tag"><%= age_group_label(member.age_group) %></span>

      <%= render "admin/families/attendance_badge", attends: member.attends %>
    </span>

    <span class="text-sm break-words text-ink-muted">
      <%= member.email.presence || t("admin.families.show.no_email") %>
    </span>

    <% tags = member_tags(member) %>

    <% if tags.any? %>
      <span class="flex flex-wrap items-center gap-1.5">
        <% tags.each do |tag| %>
          <span class="member-tag"><%= tag %></span>
        <% end %>
      </span>
    <% end %>

    <% if member.allergies.present? %>
      <span class="flex flex-wrap gap-x-1.5 rounded-[10px] bg-clay-pale px-2.5 py-1.5 text-[13px] text-clay-deep">
        <span class="font-semibold"><%= t("admin.family_members.tags.allergies") %></span>
        <span class="break-words"><%= member.allergies %></span>
      </span>
    <% end %>
  </div>

  <div class="flex gap-2">
    <%= link_to t("admin.families.show.edit_member"), edit_admin_member_path(member), class: "btn-ghost-sm" %>

    <%= render "admin/shared/destroy_button", caption: t("admin.families.show.remove_member"),
          path: admin_member_path(member),
          confirm: t("admin.families.show.remove_confirm", name: member.first_name) %>
  </div>
</li>
