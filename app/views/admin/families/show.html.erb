<% content_for :title, t("admin.families.family_name", name: @family.name) %>

<main class="admin-main max-w-[760px] gap-7">
  <div class="flex flex-col gap-2.5">
    <%= link_to t("admin.families.show.back"), admin_families_path, class: "text-sm font-semibold text-sage-deep" %>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <h1 class="page-title"><%= t("admin.families.family_name", name: @family.name) %></h1>

      <%= render "admin/families/status_badge", answered: @family.answered? %>
    </div>

    <%= link_to t("admin.families.show.rename"), edit_admin_family_path(@family),
          class: "self-start text-sm font-semibold text-sage-deep" %>
  </div>

  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
    <h2 class="text-[17px] font-semibold"><%= t("admin.families.show.members") %></h2>

    <%= link_to new_admin_family_member_path(@family), class: "btn-primary" do %>
      <%= icon("plus", class_name: "size-[18px]") %>
      <%= t("admin.families.show.add_member") %>
    <% end %>
  </div>

  <div class="rounded-2xl border border-rule-sage bg-white">
    <% if @members.any? %>
      <ul class="flex flex-col [&>li:last-child]:border-b-0">
        <%= render partial: "admin/families/member_row", collection: @members, as: :member %>
      </ul>
    <% else %>
      <%= render "admin/shared/empty_state", message: t("admin.families.show.no_members") %>
    <% end %>
  </div>
</main>
