<% content_for :title, t("admin.families.show.title", name: @family.name) %>

<main class="mx-auto flex w-full max-w-[760px] grow flex-col gap-7 px-6 pt-10 pb-20">
  <div class="flex flex-col gap-2.5">
    <%= link_to t("admin.families.show.back"), admin_families_path, class: "text-sm font-semibold text-sage-deep" %>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <h1 class="font-display text-[48px] leading-none font-medium">
        <%= t("admin.families.family_name", name: @family.name) %>
      </h1>

      <%= render "admin/families/status_badge", answered: @family.answered? %>
    </div>

    <%= link_to t("admin.families.show.rename"), edit_admin_family_path(@family), class: "self-start text-sm font-semibold text-sage-deep" %>
  </div>

  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
    <h2 class="text-[17px] font-semibold"><%= t("admin.families.show.members") %></h2>

    <%= link_to new_admin_family_member_path(@family),
          class: "inline-flex h-12 items-center gap-2 rounded-full bg-sage-deep px-[22px] font-semibold text-ground" do %>
      <%= icon("plus") %>
      <%= t("admin.families.show.add_member") %>
    <% end %>
  </div>

  <div class="rounded-2xl border border-rule-sage bg-white">
    <% if @family.family_members.any? %>
      <ul class="flex flex-col [&>li:last-child]:border-b-0">
        <% @family.family_members.each do |member| %>
          <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-rule-row px-5 py-4">
            <div class="flex min-w-0 flex-col gap-0.5">
              <span class="font-semibold"><%= member.first_name %></span>

              <span class="text-sm break-words text-ink-muted">
                <%= member.email.presence || t("admin.families.show.no_email") %>
              </span>
            </div>

            <div class="flex gap-2">
              <%= link_to t("admin.families.show.edit_member"), edit_admin_member_path(member),
                    class: "inline-flex h-10 items-center rounded-full border-[1.5px] border-rule-sand px-3.5 text-sm font-semibold" %>

              <%= button_to t("admin.families.show.remove_member"), admin_member_path(member), method: :delete,
                    form: { data: { turbo_confirm: t("admin.families.show.remove_confirm", name: member.first_name) } },
                    class: "h-10 rounded-full px-3 text-sm font-semibold text-clay" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-5 py-8 text-center text-[15px] text-ink-muted"><%= t("admin.families.show.no_members") %></p>
    <% end %>
  </div>
</main>
