<%# locals: (form:, url:, cancel_path:) %>
<%= form_with model: form, url:, class: "flex flex-col gap-5 rounded-2xl border border-rule-sage bg-white p-5 md:p-7" do |f| %>
  <%= render "admin/shared/form_errors", form: %>

  <div class="flex flex-col gap-1.5">
    <%= f.label :name, t("admin.families.form.name_label"), class: "text-[15px] font-semibold" %>

    <%= f.text_field :name, placeholder: t("admin.families.form.name_placeholder"),
          class: "h-[46px] w-full rounded-[10px] border border-rule-sand bg-white px-[14px] text-base text-ink" %>

    <span class="text-[13px] text-ink-muted"><%= t("admin.families.form.name_hint") %></span>
  </div>

  <div class="flex flex-wrap justify-end gap-3">
    <%= link_to t("admin.cancel"), cancel_path,
          class: "inline-flex h-12 items-center rounded-full border-[1.5px] border-rule-sand px-[22px] font-semibold" %>

    <%= f.submit t("admin.save"), class: "h-12 rounded-full bg-sage-deep px-6 font-semibold text-ground" %>
  </div>
<% end %>
