<%# locals: (member:) %>
<span class="flex flex-col gap-0.5 rounded-[10px] border border-rule-chip bg-ground px-2.5 py-1.5">
  <span class="text-[13px]"><%= member.first_name %></span>

  <% if member.email.present? %>
    <span class="text-xs break-words text-ink-muted"><%= member.email %></span>
  <% end %>
</span>
