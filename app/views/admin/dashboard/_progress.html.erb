<%# locals: (presenter:) %>
<% answered = capture do %>
  <p class="text-[15px] text-ink-muted">
    <span class="font-display text-3xl font-semibold text-ink">
      <%= t("admin.dashboard.show.answered_percent", percent: presenter.answered_percent) %>
    </span>

    <%= t("admin.dashboard.show.answered_caption") %>
  </p>
<% end %>

<%= render "admin/shared/card", title: t("admin.dashboard.show.progress_title", count: presenter.guests_count),
      action: answered do %>
  <div
    role="img"
    aria-label="<%= t("admin.dashboard.show.bar_label", present: presenter.present_count, absent: presenter.absent_count, pending: presenter.pending_count, total: presenter.guests_count) %>"
    class="flex h-[18px] gap-[3px] overflow-hidden rounded-full"
  >
    <span class="bg-sage-deep" style="width: <%= presenter.present_percent %>%"></span>
    <span class="bg-clay" style="width: <%= presenter.absent_percent %>%"></span>
    <span class="bg-sand" style="width: <%= presenter.pending_percent %>%"></span>
  </div>

  <div class="flex flex-wrap gap-4">
    <%= render "admin/dashboard/figure", caption: t("admin.dashboard.show.present"),
          value: presenter.present_count, rule: "border-sage-deep" %>

    <%= render "admin/dashboard/figure", caption: t("admin.dashboard.show.absent"),
          value: presenter.absent_count, rule: "border-clay" %>

    <%= render "admin/dashboard/figure", caption: t("admin.dashboard.show.pending"),
          value: presenter.pending_count, rule: "border-sand" %>

    <%= render "admin/dashboard/figure", caption: t("admin.dashboard.show.families_answered"),
          value: t("admin.families.index.stats.ratio", answered: presenter.answered_families_count, total: presenter.families_count),
          rule: "border-sage-pale" %>
  </div>
<% end %>
