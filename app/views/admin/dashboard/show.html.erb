<% content_for :title, t("admin.dashboard.show.title") %>

<main class="admin-main max-w-[1200px] gap-6">
  <%= render "admin/shared/page_header", title: t("admin.dashboard.show.title"),
        intro: t("admin.dashboard.show.deadline", date: l(Wedding::RSVP_DEADLINE.to_date, format: :long),
          countdown: rsvp_countdown) %>

  <%= render "admin/dashboard/progress", presenter: @presenter %>

  <div class="flex flex-wrap gap-6">
    <%= render "admin/dashboard/sunday_options", options: @presenter.sunday_options %>

    <%= render "admin/dashboard/diets", diets: @presenter.diets %>
  </div>

  <div class="flex flex-wrap gap-6">
    <%= render "admin/dashboard/pending_families", pending: @presenter.pending_families %>

    <%= render "admin/dashboard/recent_answers", answers: @presenter.recent_answers %>
  </div>
</main>
