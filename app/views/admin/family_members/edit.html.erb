<% content_for :title, t("admin.family_members.edit.title") %>

<main class="mx-auto flex w-full max-w-[520px] grow flex-col gap-6 px-6 pt-10 pb-20">
  <div class="flex flex-col gap-1.5">
    <h1 class="font-display text-[48px] leading-none font-medium"><%= t("admin.family_members.edit.title") %></h1>

    <p class="text-[15px] text-ink-muted">
      <%= t("admin.family_members.edit.intro", family: t("admin.families.family_name", name: @family.name)) %>
    </p>
  </div>

  <%= render "admin/family_members/form", form: @form, url: admin_member_path(@family_member),
        cancel_path: admin_family_path(@family) %>
</main>
