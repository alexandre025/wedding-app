<% content_for :title, t("admin.family_members.new.title") %>

<main class="admin-main max-w-[520px] gap-6">
  <%= render "admin/shared/page_header", title: t("admin.family_members.new.title"),
        intro: t("admin.family_members.new.intro", family: t("admin.families.family_name", name: @family.name)) %>

  <%= render "admin/family_members/form", form: @form, url: admin_family_members_path(@family),
        cancel_path: admin_family_path(@family) %>
</main>
