<%# locals: () %>
<header class="border-b border-rule-sage bg-ground">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-4">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <%= render "shared/wordmark", linked: false %>

      <span
        class="
          rounded-full border border-sage-light px-2.5 py-1 text-xs font-semibold tracking-badge text-sage-deep
          uppercase
        "
      >
        <%= t("admin.badge") %>
      </span>
    </div>

    <nav aria-label="<%= t("admin.nav.label") %>" class="flex flex-wrap items-center gap-x-7 gap-y-2 text-[15px]">
      <% admin_nav_items.each do |item| %>
        <%= render "shared/header_link", text: item[:label], path: item[:path] %>
      <% end %>

      <%= link_to t("admin.view_site"), root_path, class: "py-2.5 font-medium text-ink-muted" %>
    </nav>
  </div>
</header>
